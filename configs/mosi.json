{
  "use_bert": true,
  "use_finetune": true,
  "pretrained": "bert-base-uncased",
  "feature_dims": [768, 5, 20],
  "seq_len": 50,
  "proj_dim": 256,
  "conv_kernels": [5, 5, 5],
  "graph_window": 3,
  "gat_layers": 3,
  "gat_heads": 8,
  "dropout": 0.3,
  "mlp_hidden": 256,
  "consistency_weight": 0.1,
  "learning_rate": 0.0001,
  "weight_decay": 0.00001,
  "batch_size": 32,
  "max_epochs": 100,
  "early_stop": 15
}
